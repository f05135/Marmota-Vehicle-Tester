imports{}
triggers{
  isCategory:b=yes
  is_enabled:b=yes

  init{
    is_enabled:b=yes
    comments:t=""

    props{
      actionsType:t="PERFORM_ONE_BY_ONE"
      conditionsType:t="ALL"
      enableAfterComplete:b=no
    }

    events{
      periodicEvent{
        time:r=0.01
      }
    }

    conditions{}
    actions{
      missionMarkAsRespawnPoint{
        loc_name:t=""
        spawnEffect:b=no
        isGroundZone:b=yes
        radius:r=-1
        target:t="artillery_spawn01"
        target:t="artillery_spawn02"
        target:t="artillery_spawn03"
        target:t="artillery_spawn04"
        team:t="A"
        isStrictSpawn:b=no
        isAirfield:b=no
        isUnit:b=no
        useExisting:b=no
        isIndividual:b=no
        removeAreas:b=no
        canSpawnOnNeutral:b=no
        showOnMap:b=yes

        tags{
          artillery:b=yes
        }
      }

      addAirfield{
        air:b=yes
        ground:b=yes
        mapArea:b=yes
        area:t="battle_area_huge"
        runwayStart:t=""
        runwayEnd:t=""
        runwayWidth:r=10
        army:i=0
      }

      unitSetProperties{
        infiniteAmmo:b=yes
        object:t="player_01"
        attack_type:t="fire_at_will"
      }

      unitSetProperties{
        object:t="target_tanks_squad"
        attack_type:t="dont_aim"
        speed:r=0
        lockSpeed:b=yes
      }

      unitLoadBehTree{
        name:t="missionHitThePoint"
        objects:t="armada_01"
        objects:t="armada_02"
        objects:t="armada_03"
        objects:t="armada_04"
        loadType:t="tree"
      }

      unitMoveTo{
        target:t="heli_hover_point_01"
        horizontalDirectionForTeleport:b=yes
        object_marking:i=0
        object_var_name:t=""
        object_var_comp_op:t="equal"
        object_var_value:i=0
        target_var_name:t=""
        target_var_comp_op:t="equal"
        target_var_value:i=0
        target_marking:i=0
        waypointReachedDist:r=10
        recalculatePathDist:r=-1
        follow_target:b=no
        fastClimb:b=no
        destTimeMode:b=no
        teleportHeightType:t="absolute"
        useUnitHeightForTele:b=yes
        shouldKeepFormation:b=no
        shouldKeepAirFormation:b=yes
        teleportHeightValue:r=1000
        object:t="armada_01"
        move_type:t="move"
      }

      unitMoveTo{
